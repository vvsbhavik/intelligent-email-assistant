# Google OAuth 2.0 Credentials
# Obtain from: Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"

# Google Gemini API
# Obtain from: https://aistudio.google.com/
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Supabase PostgreSQL Configuration
# Obtain from: Supabase Project Settings → API
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# Session Secret (generate a long random string, e.g. openssl rand -hex 32)
SESSION_SECRET="your-super-secret-session-key-change-in-production"

# ── DEPLOYMENT URLS ──────────────────────────────────────────────────────────
# FRONTEND_URL  : Canonical Vercel frontend URL
#                 → used by the backend for CORS allowlist and post-OAuth redirect
FRONTEND_URL="https://intelligent-email-assistant.vercel.app"

# BACKEND_URL   : Render backend URL
#                 → used by the backend to construct the Google OAuth redirect URI
BACKEND_URL="https://intelligent-email-assistant-api.onrender.com"

# NEXT_PUBLIC_API_URL : Set this in Vercel environment variables
#                       → used by the React frontend to prefix all /api/* fetch calls
#                       → For local development use: http://localhost:3000
NEXT_PUBLIC_API_URL="https://intelligent-email-assistant-api.onrender.com"
