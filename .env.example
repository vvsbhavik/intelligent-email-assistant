# Google OAuth 2.0 Credentials
# Obtain from: Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"

# Google Gemini API
# Obtain from: https://aistudio.google.com/
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Supabase PostgreSQL Configuration
# Obtain from: Supabase Project Settings → API
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# Session Secret (generate a long random string, e.g. openssl rand -hex 32)
SESSION_SECRET="your-super-secret-session-key-change-in-production"

# Deployment URLs (required for Vercel/Render split deployment)
# FRONTEND_URL: Your Vercel frontend URL (used by the backend for CORS and OAuth redirects)
FRONTEND_URL="https://your-frontend-project.vercel.app"
# BACKEND_URL: Your Render backend URL (used by the backend to generate the correct OAuth callback URI)
BACKEND_URL="https://your-backend-service.onrender.com"
